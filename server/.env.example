# -------------------- Configuración Básica --------------------
PORT=3001

# -------------------- Seguridad --------------------
JWT_SECRET=reemplaza_este_valor_por_un_string_largo_y_aleatorio
BCRYPT_ROUNDS=10

# -------------------- Base de Datos --------------------
# Opciones: sqlite | mysql | mariadb | pg
DB_DRIVER=sqlite

# Para SQLite (dev local, no requiere servicio externo):
DATABASE_URL=file:./database/app.db

# Para MySQL / MariaDB (producción o local - TiDB Cloud, Railway, PlanetScale, Clever Cloud, XAMPP, Aiven):
# DB_DRIVER=mysql
# DATABASE_URL=mysql://usuario:password@host:3306/nombre_db
# DB_SSL=true  # Opcional, para servicios que exijan conexión TLS/SSL cifrada

# Para PostgreSQL:
# DB_DRIVER=pg
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
